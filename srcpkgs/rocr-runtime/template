# Template file for 'rocr-runtime'
pkgname=rocr-runtime
version=7.2.3
revision=1
build_style=cmake
configure_args="
 -G Ninja
 -DCMAKE_BUILD_TYPE=Release
 -DCMAKE_INSTALL_PREFIX=/usr
 -DBUILD_TESTING=OFF
"
hostmakedepends="cmake ninja pkg-config python3 rocm-llvm xxd"
makedepends="libnuma-devel libdrm-devel elfutils-devel rocm-device-libs"
depends="libnuma libdrm libelf"
shlib_provides="libhsa-runtime64.so.1"
short_desc="ROCm HSA runtime (ROCr)"
maintainer="mark <mark@local>"
license="NCSA"
